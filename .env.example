# AWS基本設定（デプロイ先リージョンに合わせて変更してください。例: us-west-2, ap-northeast-1）
AWS_REGION=us-east-1

# Bedrock モデル設定
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5
AGENT_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Strands Agent経由（ペルソナ生成・レポート等）の出力トークン上限。
# 未設定時のデフォルトは32000。多数のペルソナを一括生成する場合に調整する。
# AGENT_MAX_TOKENS=32000

# ペルソナ議論・インタビューで非Anthropicモデル（GPT-5.6 Terra/Luna、Gemma 4 31B）を
# Bedrock Mantle経由で選択可能にする。要 bedrock-mantle:CreateInference +
# bedrock-mantle:CallWithBearerToken のIAM権限（既存AWS認証情報から短期トークンを生成）。
ENABLE_MANTLE_MODELS=false

# DynamoDB設定（AWS_REGIONと同じリージョンを指定）
DYNAMODB_TABLE_PREFIX=AIPersona
DYNAMODB_REGION=us-east-1

# S3設定（ファイルストレージ）
S3_BUCKET_NAME=your-bucket-name

# AgentCore Memory設定（長期記憶機能を使用する場合）
ENABLE_LONG_TERM_MEMORY=false
AGENTCORE_MEMORY_ID=your-memory-id
AGENTCORE_MEMORY_REGION=us-east-1  # AWS_REGIONと同じリージョンを指定
MEMORY_STRATEGY=summary
MEMORY_MAX_RESULTS=5
SUMMARY_MEMORY_STRATEGY_ID=your-summary-strategy-id
SEMANTIC_MEMORY_STRATEGY_ID=your-semantic-strategy-id

# マスアンケート機能設定
BATCH_INFERENCE_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_BATCH_ROLE_ARN=arn:aws:iam::123456789012:role/BedrockBatchInferenceRole
SURVEY_S3_PREFIX=survey-results/
BATCH_INFERENCE_S3_PREFIX=batch-inference/

# ペルソナ生成キャッシュTTL（秒、デフォルト: 14400 = 4時間）
# PERSONA_CACHE_TTL_SECONDS=14400
