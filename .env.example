# AWS基本設定（デプロイ先リージョンに合わせて変更してください。例: us-west-2, ap-northeast-1）
AWS_REGION=us-east-1

# ログイン方式（必須）。手元では local、AWS 上（ECS）では oidc（CDK が設定する）。
# 未設定・未知の値では起動しない。local は ECS の中では起動しない。
AUTH_MODE=local
# local の開発用の利用者（ロール・部署はカンマ区切り。ロールは admin / member。
# ロールを空にすると「利用権限がまだありません」の画面だけになる）
# LOCAL_DEV_USER_NAME=開発ユーザー
# LOCAL_DEV_USER_EMAIL=dev@example.com
# LOCAL_DEV_USER_ROLES=member
# LOCAL_DEV_USER_GROUPS=
# アプリ自身の URL（ログアウトのフォーム送信の Origin 照合に使う）
# APP_BASE_URL=http://localhost:8000
# 認証の処理時間ログ（auth.request_checked）を出す割合（0〜1、既定 0.1）
# AUTH_TIMING_SAMPLE_RATE=0.1
# AUTH_MODE=oidc のときの設定は CDK（App スタック）が環境変数とシークレットで渡すため、
# 手元の .env には書かない（COGNITO_*、TOKEN_ENCRYPTION_KEYS、LOGIN_COOKIE_SIGNING_KEY、
# SESSIONS_TABLE_NAME）。
# テーブル名は DYNAMODB_TABLE_PREFIX から組み立てる。v1.0.0 の Data スタックが作った
# テーブルを手元から使うときだけ、テーブルごとの物理名を書く（例）:
# PERSONAS_TABLE_NAME=AIPersonaDev-Data-DatabasePersonasXXXXXXXX

# 推論の範囲（閉域対応 U5）。global（既定）か jp（国内の推論プロファイルだけ）。
# 大文字・小文字は区別しない。ほかの値は起動を止める。
# jp と ENABLE_ADDITIONAL_PERSONA_MODELS=true は同時に使えない（追加のモデルは Bedrock Mantle
# 経由で米国のリージョンを呼ぶため、起動を止める）。
# INFERENCE_SCOPE=global

# Bedrock モデル設定。書かなければ範囲の既定を使う（書いた値は範囲と照らさずにそのまま使う）。
#   global: BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5-5
#           AGENT_MODEL_ID=global.anthropic.claude-haiku-5-5
#           BATCH_INFERENCE_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
#   jp:     BEDROCK_MODEL_ID=jp.anthropic.claude-haiku-5-5
#           AGENT_MODEL_ID=jp.anthropic.claude-haiku-5-5
#           BATCH_INFERENCE_MODEL_ID=jp.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5-5
# AGENT_MODEL_ID=global.anthropic.claude-haiku-5-5
# Strands Agent経由（ペルソナ生成・レポート等）の出力トークン上限。
# 未設定時のデフォルトは32000。多数のペルソナを一括生成する場合に調整する。
# AGENT_MAX_TOKENS=32000

# ペルソナ議論・インタビューで追加ペルソナベースモデル
ENABLE_ADDITIONAL_PERSONA_MODELS=false

# DynamoDB設定（AWS_REGIONと同じリージョンを指定）
DYNAMODB_TABLE_PREFIX=AIPersona
DYNAMODB_REGION=us-east-1

# S3設定（ファイルストレージ）
S3_BUCKET_NAME=your-bucket-name

# AgentCore Memory設定（長期記憶機能を使用する場合）
ENABLE_LONG_TERM_MEMORY=false
AGENTCORE_MEMORY_ID=your-memory-id
AGENTCORE_MEMORY_REGION=us-east-1  # AWS_REGIONと同じリージョンを指定
MEMORY_STRATEGY=summary
MEMORY_MAX_RESULTS=5
SUMMARY_MEMORY_STRATEGY_ID=your-summary-strategy-id
SEMANTIC_MEMORY_STRATEGY_ID=your-semantic-strategy-id

# マスアンケート機能設定
# BATCH_INFERENCE_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0（書かなければ範囲の既定）
BEDROCK_BATCH_ROLE_ARN=arn:aws:iam::123456789012:role/BedrockBatchInferenceRole
SURVEY_S3_PREFIX=survey-results/
BATCH_INFERENCE_S3_PREFIX=batch-inference/

# 閉域で使えない機能の切り替え（閉域構成では CDK が閉域のタスクにだけ渡す。公開構成と手元では書かない）
# 値が許されない値なら起動しない（既定値には落とさない）。
# Nemotron の入手先: huggingface（既定。管理者が画面から取得）か s3（事前に S3 に配置したファイルを使う）
# NEMOTRON_SOURCE=huggingface
# Nemotron の Parquet のキー（S3_BUCKET_NAME のバケットの中）。英数字・. ・_ ・- ・/ だけで末尾は .parquet。
# persona-dataset/custom/ と persona-dataset/temp/ の下は使えない
# NEMOTRON_DATASET_KEY=persona-dataset/nemotron-personas-japan.parquet
# データ分析エージェントをこの環境で使ってよいか（true が既定。false では設定画面からも有効にできない）
# DATA_AGENT_ALLOWED=true
# ファイル（アバター・アンケート CSV・アンケートの画像・テンプレート画像・議論の添付）の配信の方式（閉域対応 U4）。
# presigned（既定。S3 の署名付き URL へ 302）か proxy（アプリが流す）。大文字・小文字は問わない。
# 閉域の Stage には CDK が proxy を渡す。手元で閉域の振る舞いを確かめるときだけ proxy にする
# ASSET_DELIVERY=presigned

# ペルソナ生成キャッシュTTL（秒、デフォルト: 14400 = 4時間）
# PERSONA_CACHE_TTL_SECONDS=14400

# analyze_dataset（DuckDB）の同時実行クエリ数上限（デフォルト: 4、1以上）。
# 各クエリはデータセットをin-memoryに展開するため、ピークメモリは
# 同時実行数×データセットサイズに比例する。デプロイ先のメモリに応じて調整する。
# DATASET_ANALYSIS_MAX_CONCURRENT_QUERIES=4
